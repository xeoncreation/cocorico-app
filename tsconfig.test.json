{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "types": ["jest", "node", "@testing-library/jest-dom"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "cocorico-mobile",
    "supabase/functions",
    "public",
    "out",
    "build",
    "dist",
    "test-results",
    "repo-cleanup",
    ".next",
    ".next-*",
    "playwright-report"
  ]
}