{
  "name": "cocorico",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dev:127": "cross-env NEXT_DIST_DIR=.next-3000 next dev -H 127.0.0.1 -p 3000",
    "dev:127:detach": "powershell -NoProfile -Command \"Start-Process -FilePath 'npm' -ArgumentList 'run','dev:127' -WindowStyle Hidden\"",
    "dev:restart": "node scripts/restart-dev.js",
    "dev:all": "next dev -H 0.0.0.0 -p 3000",
    "dev:localhost": "next dev -H localhost -p 3000",
    "dev:ipv6": "next dev -H :: -p 3000",
    "dev:3001": "cross-env NEXT_DIST_DIR=.next-3001 next dev -p 3001 -H 127.0.0.1",
    "dev:no-pwa": "node scripts/run-dev.js --no-pwa",
    "dev:no-intl": "node scripts/run-dev.js --no-intl",
    "dev:min": "node scripts/run-dev.js --minimal",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start -H localhost -p 3000",
    "start:3001": "next start -p 3001",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "sitemap": "next-sitemap",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit/",
    "test:nav": "jest tests/unit/navbar-links.test.tsx",
    "test:recipe-form": "jest tests/unit/RecipeForm.test.tsx",
    "test:search-filters": "jest tests/unit/SearchFilters.test.tsx",
    "test:e2e": "cross-env NEXT_PUBLIC_DISABLE_ANALYTICS=1 playwright test",
    "test:e2e:ui": "cross-env NEXT_PUBLIC_DISABLE_ANALYTICS=1 playwright test --ui",
    "test:e2e:search": "playwright test tests/e2e/recipe-search.spec.ts",
    "test:e2e:public": "playwright test tests/e2e/public-recipe.spec.ts",
    "seed:e2e": "node scripts/seed-e2e.js",
    "ci:prepare": "npm run seed:e2e || true",
    "test:e2e:ci": "npm run ci:prepare && cross-env NEXT_PUBLIC_DISABLE_ANALYTICS=1 npx playwright test",
    "start:e2e": "npm run build && npm run start",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts",
    "test:all": "npm run test && npm run test:e2e",
    "scan-secrets": "secretlint \"**/*\" --ignore-path .gitignore",
    "audit:env": "ts-node scripts/audit-env.ts",
    "export:users": "ts-node scripts/export-users.ts",
    "dev:trace": "node --trace-exit node_modules/next/dist/bin/next dev -p 3000",
    "dev:inspect": "node --inspect-brk node_modules/next/dist/bin/next dev -p 3000",
    "generate:sprites": "node scripts/generate-sprites.js",
    "lint:spell": "cspell \"**/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.80",
    "@ai-sdk/react": "^2.0.109",
    "@headlessui/react": "^2.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.15",
    "@stripe/stripe-js": "^8.3.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.80.0",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.20.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "ai": "^5.0.108",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "elevenlabs-node": "^1.0.4",
    "firebase": "^12.6.0",
    "framer-motion": "^12.23.24",
    "lottie-web": "^5.12.2",
    "lucide-react": "^0.548.0",
    "next": "^14.0.3",
    "next-intl": "^4.4.0",
    "next-pwa": "^5.6.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "openai": "^6.7.0",
    "qrcode.react": "^4.2.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.66.0",
    "react-qr-code": "^2.0.18",
    "recharts": "^3.3.0",
    "replicate": "^0.31.1",
    "sonner": "^2.0.7",
    "stripe": "^19.2.1",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.169.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.39.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.0",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "autoprefixer": "^10.4.16",
    "cross-env": "^10.1.0",
    "cspell": "^9.3.2",
    "cspell-dict-es-es": "^1.1.2",
    "eslint": "^8.53.0",
    "eslint-config-next": "^14.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.31",
    "secretlint": "^7.0.0",
    "sharp": "^0.33.5",
    "tailwindcss": "3.3.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2"
  }
}
