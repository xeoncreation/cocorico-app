{
  "files.associations": {
    "*.sql": "postgres"
  },
  "sqltools.connections": [
    {
      "previewLimit": 50,
      "driver": "PostgreSQL",
      "name": "Supabase",
      "database": "postgres",
      "username": "postgres"
    }
  ],
  "css.lint.unknownAtRules": "ignore",
  "markdownlint.config": {
    "MD022": false,
    "MD024": false,
    "MD029": false,
    "MD031": false,
    "MD032": false,
    "MD034": false,
    "MD036": false,
    "MD040": false
  },
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [
    { "directory": ".", "changeProcessCWD": true }
  ],
  "eslint.options": {
    "ignorePath": ".eslintignore"
  },
  "eslint.validate": [
    "typescript",
    "typescriptreact"
  ],
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.preferences.includePackageJsonAutoImports": "off",
  "typescript.suggest.autoImports": false,
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.surveys.enabled": false,
  "javascript.validate.enable": false,
  "eslint.enable": true,
  "eslint.probe": [
    "typescript",
    "typescriptreact"
  ],
  "eslint.format.enable": false,
  "typescript.validate.enable": true,
  "problems.showCurrentInStatus": true,
  "problems.defaultViewMode": "tree",
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/node_modules/**": true,
    "**/out/**": true,
    "**/build/**": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/.next-*": true,
    "**/node_modules": true,
    "**/out": true,
    "**/build": true,
    "**/dist": true,
    "**/test-results": true,
    "**/repo-cleanup": true,
    "**/cocorico-mobile": true,
    "**/playwright-report": true,
    "**/coverage": true
  },
  "typescript.preferences.includePackageJsonAutoImports": "off",
  "typescript.suggest.autoImports": false,
  "i18n-ally.localesPaths": [
    "i18n",
    "src/i18n",
    "src/messages",
    "src/app/api/messages"
  ],
  "cSpell.language": "en,es",
  "cSpell.words": [
    "Cocorico",
    "Precios",
    "Elige",
    "Prueba",
    "desbloquea",
    "funciones",
    "Aprovecha",
    "poder",
    "Premium",
    "Gratis",
    "Empezar",
    "Mensual",
    "acceso",
    "completo",
    "todas",
    "características",
    "Suscribirse",
    "Características",
    "incluidas",
    "Imágenes",
    "ilimitadas",
    "resolución",
    "Comparación",
    "modelos",
    "Descarga",
    "marcas",
    "agua",
    "Histórico",
    "generaciones",
    "ilimitado",
    "Soporte",
    "prioritario",
    "Acceso",
    "nuevas",
    "funcionalidades",
    "Edición",
    "avanzada",
    "imágenes",
    "Exportar",
    "formatos",
    "básicas",
    "límite",
    "generación",
    "calidad",
    "estándar",
    "Marca",
    "Historial",
    "limitado",
    "días",
    "básico",
    "limitada"
  ]
}
